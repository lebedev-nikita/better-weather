<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="1dp"
    android:paddingBottom="1dp"
    android:background="@drawable/widget_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/widget_ink"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:text="@string/widget_choose_city_compact"
            android:textSize="11sp"
            android:textColor="@color/widget_secondary"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:baselineAligned="false">
        <TextView
            android:id="@+id/widget_temperature"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/reading_unavailable"
            android:textSize="22sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeStepGranularity="1sp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/widget_ink"
            android:includeFontPadding="false"
            android:gravity="center_vertical"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_wind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.6"
            android:layout_marginEnd="4dp"
            android:text="@string/reading_unavailable"
            android:textSize="11sp"
            android:textColor="@color/widget_ink"
            android:includeFontPadding="false"
            android:gravity="end"
            android:maxLines="1" />
        <TextView
            android:id="@+id/widget_uv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.2"
            android:text="@string/widget_uv_unavailable"
            android:textSize="11sp"
            android:textColor="@color/widget_ink"
            android:includeFontPadding="false"
            android:gravity="end"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
